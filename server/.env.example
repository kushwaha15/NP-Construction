# MongoDB database connection string
MONGODB_URI=
# HTTP port; Render provides this in production
PORT=
# Exact frontend origin allowed by CORS
CLIENT_URL=
# Admin login password; set explicitly in production
ADMIN_PASSWORD=
# Notification recipient for contact-form submissions
OWNER_EMAIL=
# Gmail account used to send notification and reply email
EMAIL_USER=
# Gmail App Password used by the mail transport
EMAIL_PASS=
# Cloudinary account name for portfolio uploads
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key for portfolio uploads
CLOUDINARY_API_KEY=
# Cloudinary API secret for portfolio uploads
CLOUDINARY_API_SECRET=